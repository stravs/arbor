---
import { t, type Lang } from '../i18n';
import { defaultHours, weekLines, type Hours } from '../lib/content';

interface Props {
  lang: Lang;
  // Only given in `astro dev`; the Worker fills in the stored hours on the live site.
  hours?: Hours;
  class?: string;
}
const { lang, hours = defaultHours, class: className } = Astro.props;
---

<span
  class={className}
  data-open-status
  data-hours={JSON.stringify(hours)}
  data-open-text={t[lang].openNow}
  data-closed-text={t[lang].closedNow}
>{weekLines(hours, lang, true)[0]}</span>
