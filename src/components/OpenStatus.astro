---
import { t, type Lang } from '../data/site';
import { defaultHours, weekLines } from '../lib/content';

interface Props {
  lang: Lang;
  class?: string;
}
const { lang, class: className } = Astro.props;
---

<span
  class={className}
  data-open-status
  data-hours={JSON.stringify(defaultHours)}
  data-open-text={t[lang].openNow}
  data-closed-text={t[lang].closedNow}
>{weekLines(defaultHours, lang, true)[0]}</span>
