---
import type { ImageOutputFormat } from 'astro';
import { Image, Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import OpenStatus from '../components/OpenStatus.astro';
import { allergens, menu } from '../data/menu';
import { contact, dayName, images, price, specials } from '../data/site';
import { defaultLang, langNames, langPath, langs, t, type Lang } from '../i18n';
import { defaultHours, exceptionLines, localNow, lunchWeek, shortDate, weekLines, type Content } from '../lib/content';

export function getStaticPaths() {
  return langs.map((lang) => ({
    params: { lang: lang === defaultLang ? undefined : lang },
    props: { lang },
  }));
}

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const s = t[lang];
// Daily lunches are only published in Slovenian.
const sl = lang === 'sl';
const formats: ImageOutputFormat[] = ['avif', 'webp'];

// Malice and opening hours are filled in at the edge from KV (worker/index.ts), so the
// markup below only carries the hooks: data-lunch, data-day, data-lunch-date,
// data-lunch-items and data-hours-lines. Without stored malice the lunch parts stay hidden.
// `astro dev` runs without the Worker and reads both from the local store instead, through
// the editor's API (astro.config.mjs). Fill that store with `npm run seed:malice -- --local`.
const today = localNow().date;
const week = lunchWeek(today);
const dev: Content | null = import.meta.env.DEV
  ? await fetch(new URL('/pero/api/content', Astro.url)).then((res) => res.json()).catch(() => null)
  : null;
const stored = dev?.malice ?? {};
const hours = dev?.hours ?? defaultHours;
const lunchDays = [1, 2, 3, 4, 5]
  .map((day, i) => ({ day, date: stored[week[i]] ? week[i] : undefined, items: stored[week[i]] ?? [] }))
  .filter((d) => !import.meta.env.DEV || d.items.length);
const noLunch = !lunchDays.length || !import.meta.env.DEV;
const openHours = weekLines(hours, lang, true);
const allHours = [...weekLines(hours, lang), ...exceptionLines(hours, lang, today)];
---

<Base lang={lang}>
  <div class="page">
    <header class="top">
      <a href="#top" class="logo" aria-label={contact.name}>
        <Image src={images.logo} alt="Arbor" width={108} loading="eager" />
      </a>
      <nav id="nav" aria-label={s.navLabel}>
        <a href="#arbor" translate="no">{s.nav.about}</a>
        <a href="#specialitete">{s.nav.specials}</a>
        <a href="#meni">{s.nav.menu}</a>
        {sl && <a href="#malice" data-lunch hidden={noLunch}>{s.nav.lunch}</a>}
        <a href="#kontakt">{s.nav.contact}</a>
      </nav>
      <div class="top-end">
        <div class="langs">
          {
            langs.filter((l) => l !== lang).map((l) => (
              <a href={langPath(l)} lang={l} hreflang={l} aria-label={langNames[l]} translate="no">
                {l.toUpperCase()}
              </a>
            ))
          }
        </div>
        <button class="burger" type="button" aria-label={s.nav.menu} aria-controls="nav" aria-expanded="false">
          <span></span>
        </button>
      </div>
    </header>

    <main id="top">
      <section class="hero">
        <div class="hero-copy">
          {
            sl && (
              <div class="today-card" data-lunch-today hidden>
                {
                  lunchDays.map((d) => (
                    <div class="panel" data-day={d.day} data-date-panel={d.date}>
                      <p class="eyebrow">
                        {s.lunchToday} · <span>{dayName(d.day, lang)} <span data-lunch-date={d.day}>{shortDate(d.date ?? null)}</span></span>
                      </p>
                      <ol data-lunch-items={d.day}>
                        {d.items.map((item) => <li>{item}</li>)}
                      </ol>
                    </div>
                  ))
                }
                <p class="hours">11h–14h</p>
              </div>
            )
          }
          <h1>{s.tagline}</h1>
          <p class="sub">{s.heroSub}</p>
          <div class="cta">
            <a class="btn" href="#specialitete">{s.ctaSpecials}</a>
            <a class="btn outline" href="#meni">{s.menuCta}</a>
          </div>
        </div>
        <div class="hero-art">
          <figure class="arch">
            <Picture
              src={images.arbor2}
              alt={s.heroAlt}
              formats={formats}
              width={520}
              sizes="(min-width: 900px) min(520px, 40vw), min(420px, 90vw)"
              priority
            />
          </figure>
          <div class="badge">
            <Image src={images.eatLocal} alt="Eat local, eat fresh" width={104} />
          </div>
        </div>
      </section>

      <ul class="strip">
        <li>
          <span>{s.hoursLabel}</span>
          <strong data-hours-lines="open" set:html={openHours.join('<br />')} />
          <OpenStatus lang={lang} hours={hours} class="status" />
        </li>
        <li>
          <span>{s.addressLabel}</span>
          <strong><a href={contact.maps}>{contact.street}, Bled</a></strong>
        </li>
      </ul>

      <section class="about" id="arbor">
        <div class="about-art">
          <figure class="tall">
            <Picture src={images.arbor3} alt={s.castleAlt} formats={formats} widths={[400, 700, 1000]} sizes="(min-width: 900px) 32vw, 70vw" />
          </figure>
          <figure class="small">
            <Picture src={images.arbor1} alt={s.roomAlt} formats={formats} widths={[320, 560, 800]} sizes="(min-width: 900px) 24vw, 50vw" />
          </figure>
        </div>
        <div class="about-copy">
          <p class="eyebrow">Arbor</p>
          <h2>{s.aboutTitle}</h2>
          {s.about.map((p) => <p>{p}</p>)}
          <dl>
            <div>
              <dt>{contact.seatsInside}</dt>
              <dd>{s.seatsInside}</dd>
            </div>
            <div>
              <dt>{contact.seatsTerrace}</dt>
              <dd>{s.seatsTerrace}</dd>
            </div>
          </dl>
        </div>
      </section>

      <section class="specials" id="specialitete">
        <div class="head">
          <div>
            <p class="eyebrow">{s.specialsSub}</p>
            <h2>{s.specialsTitle}</h2>
          </div>
          <a class="link" href="#meni">{s.menuCta} <span aria-hidden="true">→</span></a>
        </div>
        <ul class="dishes">
          {
            specials.map((d) => (
              <li>
                <figure>
                  <Picture
                    src={d.image}
                    alt={d.name[lang]}
                    formats={formats}
                    widths={[400, 640, 900]}
                    sizes="(min-width: 900px) 30vw, (min-width: 560px) 45vw, 90vw"
                  />
                </figure>
                <h3>{d.name[lang]}</h3>
                <p>{d.desc[lang]}</p>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="menu" id="meni">
        <div class="head">
          <h2>{s.menuTitle}</h2>
        </div>
        <div class="cols">
          {
            menu.map((c) => (
              <div class="cat">
                <h3>{c.title[lang]}</h3>
                <ul>
                  {c.items.map((i) => (
                    <li>
                      <div class="row">
                        <h4>
                          {i.name[lang]} {i.wait && <span class="wait">15 min</span>}
                        </h4>
                        <span class="price">{price(i.price, lang)}</span>
                      </div>
                      {i.desc && <p>{i.desc[lang]}</p>}
                      {i.tags && (
                        <p class="tags">
                          {i.tags.map((tag) => <abbr title={allergens[tag][lang]}>{tag}</abbr>)}
                        </p>
                      )}
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
        <div class="legend">
          <p class="eyebrow">{s.allergensTitle}</p>
          <p>{s.allergensNote}</p>
          <ul>
            {
              Object.entries(allergens).map(([code, label]) => (
                <li>
                  <b>{code}</b> {label[lang]}
                </li>
              ))
            }
          </ul>
        </div>
      </section>

      {
        sl && (
        <section class="lunch" id="malice" data-lunch hidden={noLunch}>
          <div class="head">
            <div>
              <p class="eyebrow">{s.lunchHours}</p>
              <h2>{s.lunchWeek}</h2>
            </div>
          </div>
          <ul class="week">
            {
              lunchDays.map((d) => (
                <li data-day={d.day}>
                  <p class="day">
                    {dayName(d.day, lang)} <span data-lunch-date={d.day}>{shortDate(d.date ?? null)}</span>
                  </p>
                  <p class="today">{s.today}</p>
                  <ol data-lunch-items={d.day}>
                    {d.items.map((item) => <li>{item}</li>)}
                  </ol>
                </li>
              ))
            }
          </ul>
        </section>
        )
      }

      <section class="contact" id="kontakt">
        <p class="eyebrow">{s.contactSub}</p>
        <h2>{s.contactTitle}</h2>
        <a class="phone" href={`tel:${contact.tel}`}>{contact.phone}</a>
        <ul>
          <li>
            <span>{s.addressLabel}</span>
            {contact.street}<br />{contact.city}<br />
            <a href={contact.maps}>{s.directions} →</a>
          </li>
          <li>
            <span>{s.hoursLabel}</span>
            <div data-hours-lines="all" set:html={allHours.join('<br />')} />
          </li>
          <li>
            <span>E-mail</span>
            <a href={`mailto:${contact.email}`}>{contact.email}</a>
          </li>
          <li>
            <span>Instagram</span>
            <a href={`https://www.instagram.com/${contact.instagram}/`} rel="noopener">@{contact.instagram}</a>
          </li>
        </ul>
        <p class="award">{s.award}</p>
      </section>
    </main>

    <footer>
      <span>© Arbor d.o.o.</span>
    </footer>
  </div>
</Base>

<script>
  const burger = document.querySelector<HTMLButtonElement>('.burger');
  const nav = document.getElementById('nav');
  const setOpen = (open: boolean) => burger?.setAttribute('aria-expanded', String(open));
  burger?.addEventListener('click', () => setOpen(burger.getAttribute('aria-expanded') !== 'true'));
  nav?.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) setOpen(false);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') setOpen(false);
  });
</script>

<style>
  .page {
    --paper: #f6f1e7;
    --paper-2: #ede5d5;
    --ink: #1c241e;
    --muted: #5d665e;
    --green: #0b4b24;
    --gold: #a8833f;
    --line: #d8cfbb;
    --serif: var(--font-fraunces);
    --sans: var(--font-instrument-sans);
    --pad: clamp(20px, 5vw, 72px);
    background: var(--paper);
    color: var(--ink);
    font: 17px/1.6 var(--sans);
    overflow-x: clip;
  }

  .eyebrow {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--gold);
  }
  h1,
  h2,
  h3 {
    font-family: var(--serif);
    font-weight: 380;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }
  h2 {
    margin-top: 12px;
    font-size: clamp(34px, 4.6vw, 60px);
    line-height: 1.05;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    padding: 13px 24px;
    border-radius: 999px;
    background: var(--green);
    color: var(--paper);
    font-weight: 600;
    font-size: 15px;
    text-decoration: none;
    transition: background 0.2s;
  }
  .btn:hover {
    background: #083a1c;
  }
  .btn.outline {
    background: none;
    box-shadow: inset 0 0 0 1.5px var(--green);
    color: var(--green);
  }
  .btn.outline:hover {
    background: var(--green);
    color: var(--paper);
  }
  .link {
    font-weight: 600;
    font-size: 15px;
    color: var(--green);
    text-decoration: none;
    white-space: nowrap;
  }
  .link span {
    display: inline-block;
    transition: transform 0.2s;
  }
  .link:hover span {
    transform: translateX(4px);
  }

  /* Header */
  .top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 20px var(--pad);
  }
  .logo :global(img) {
    width: 108px;
  }
  .top nav {
    display: flex;
    gap: 28px;
    font-size: 17px;
    font-weight: 500;
  }
  .top nav a,
  .langs a {
    text-decoration: none;
  }
  .top nav a:hover,
  .langs a:hover {
    color: var(--green);
  }
  .top-end {
    display: flex;
    align-items: center;
    gap: 20px;
  }
  .langs {
    display: flex;
    gap: 12px;
    font-size: 16px;
    color: var(--muted);
  }
  .burger {
    display: none;
    width: 44px;
    height: 44px;
    margin-right: -10px;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    cursor: pointer;
  }
  .burger span,
  .burger span::before,
  .burger span::after {
    display: block;
    width: 24px;
    height: 2px;
    margin: auto;
    background: currentColor;
    transition: transform 0.2s;
  }
  .burger span {
    position: relative;
  }
  .burger span::before,
  .burger span::after {
    content: '';
    position: absolute;
    left: 0;
  }
  .burger span::before {
    transform: translateY(-7px);
  }
  .burger span::after {
    transform: translateY(7px);
  }
  .burger[aria-expanded='true'] span {
    background: none;
  }
  .burger[aria-expanded='true'] span::before {
    transform: rotate(45deg);
  }
  .burger[aria-expanded='true'] span::after {
    transform: rotate(-45deg);
  }

  /* Hero */
  .hero {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    align-items: center;
    gap: clamp(32px, 6vw, 96px);
    padding: clamp(16px, 2.5vw, 36px) var(--pad) clamp(48px, 7vw, 96px);
  }
  h1 {
    font-size: clamp(44px, 6.2vw, 88px);
    line-height: 0.98;
    letter-spacing: -0.035em;
  }
  .sub {
    max-width: 30em;
    margin-top: 28px;
    font-size: clamp(17px, 1.5vw, 20px);
    color: var(--muted);
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 28px;
    margin-top: 36px;
  }
  .today-card {
    position: relative;
    margin-bottom: clamp(28px, 3.5vw, 44px);
    padding: clamp(16px, 1.6vw, 20px) 0;
    border-block: 1px solid var(--line);
  }
  .today-card[hidden] {
    display: none;
  }
  .today-card .eyebrow {
    padding-right: 76px;
  }
  .today-card .eyebrow span {
    white-space: nowrap;
  }
  .panel {
    display: none;
  }
  .panel[data-active] {
    display: block;
  }
  .hours {
    position: absolute;
    top: clamp(16px, 1.6vw, 20px);
    right: 0;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.06em;
    color: var(--muted);
  }
  .today-card ol {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    margin-top: 12px;
  }
  .today-card ol li {
    padding: 0 16px;
    border-left: 1px solid var(--line);
    font: 380 clamp(18px, 1.55vw, 22px) / 1.25 var(--serif);
  }
  .today-card ol li:first-child {
    padding-left: 0;
    border-left: 0;
  }
  .today-card ol {
    counter-reset: n;
  }
  .today-card ol li {
    counter-increment: n;
  }
  .today-card ol li::before {
    content: counter(n) '.';
    margin-right: 0.45em;
    font-style: italic;
    color: var(--gold);
  }
  .hero-art {
    position: relative;
    justify-self: end;
    width: 100%;
    max-width: 520px;
  }
  .arch {
    overflow: hidden;
    aspect-ratio: 4 / 5;
    border-radius: 999px 999px 6px 6px;
  }
  .arch :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .badge {
    position: absolute;
    left: -44px;
    bottom: 40px;
    display: grid;
    place-items: center;
    width: 148px;
    height: 148px;
    border-radius: 50%;
    background: var(--paper);
  }
  .badge :global(img) {
    width: 104px;
    /* The ring's centre sits above the image centre because of the stem. */
    translate: 0 3.85%;
    transform-origin: 50% 46.15%;
    transition: transform 1s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .badge:hover :global(img) {
    transform: rotate(360deg);
  }
  @media (prefers-reduced-motion: reduce) {
    .badge :global(img) {
      transition: none;
    }
  }

  /* Info strip */
  .strip {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 1fr;
    margin: 0 var(--pad);
    border-block: 1px solid var(--line);
  }
  .strip li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 2px 12px;
    padding: 22px 24px;
  }
  .strip li + li {
    border-left: 1px solid var(--line);
  }
  .strip li:first-child {
    padding-left: 0;
  }
  .strip span:first-child {
    width: 100%;
    font-size: 13px;
    color: var(--muted);
  }
  .strip strong {
    font-weight: 600;
  }
  .strip a {
    text-decoration-color: var(--line);
    text-underline-offset: 4px;
  }
  .page :global(.status) {
    font-size: 13px;
    font-weight: 600;
    color: var(--muted);
  }
  .page :global(.status:not([data-state])) {
    display: none;
  }
  .page :global(.status[data-state='open']) {
    color: var(--green);
  }
  .page :global(.status)::before {
    content: '';
    display: inline-block;
    width: 7px;
    height: 7px;
    margin-right: 6px;
    border-radius: 50%;
    background: currentColor;
    vertical-align: 1px;
  }

  /* About */
  .about {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: clamp(32px, 7vw, 112px);
    padding: clamp(72px, 10vw, 144px) var(--pad);
  }
  .about-art {
    position: relative;
    padding: 0 18% 12% 0;
  }
  .about-art figure {
    overflow: hidden;
    border-radius: 6px;
  }
  .about-art .small {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 52%;
    border: 8px solid var(--paper);
  }
  .about-copy > p:not(.eyebrow) {
    max-width: 34em;
    margin-top: 20px;
    color: var(--muted);
  }
  .about-copy h2 + p {
    margin-top: 28px;
  }
  dl {
    display: flex;
    gap: 48px;
    margin: 40px 0 0;
    padding-top: 28px;
    border-top: 1px solid var(--line);
  }
  dt {
    font: 380 56px/1 var(--serif);
    font-variant-numeric: lining-nums;
    color: var(--green);
  }
  dd {
    margin: 6px 0 0;
    font-size: 14px;
    color: var(--muted);
  }

  /* Specials */
  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 20px 40px;
  }
  .specials {
    padding: clamp(64px, 8vw, 112px) var(--pad);
    background: var(--paper-2);
  }
  .dishes {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 48px 32px;
    margin-top: 56px;
  }
  .dishes figure {
    overflow: hidden;
    aspect-ratio: 4 / 3;
    border-radius: 6px;
  }
  .dishes :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .dishes li:hover :global(img) {
    transform: scale(1.04);
  }
  .dishes h3 {
    margin-top: 18px;
  }
  .row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    margin-top: 18px;
  }
  h3 {
    font-size: 26px;
    line-height: 1.15;
  }
  .price {
    font: 380 22px/1 var(--serif);
    color: var(--green);
    white-space: nowrap;
  }
  .dishes p {
    margin-top: 4px;
    font-size: 15px;
    color: var(--muted);
  }

  /* Menu */
  .menu {
    padding: clamp(64px, 8vw, 112px) var(--pad);
  }
  .cols {
    columns: 2;
    column-gap: clamp(40px, 6vw, 96px);
    margin-top: 56px;
  }
  .cat {
    break-inside: avoid;
    padding-bottom: 48px;
  }
  .cat h3 {
    padding-bottom: 12px;
    border-bottom: 1px solid var(--ink);
    color: var(--green);
  }
  .cat li {
    padding: 14px 0;
    border-bottom: 1px solid var(--line);
  }
  .cat .row {
    margin-top: 0;
  }
  h4 {
    margin: 0;
    font: 500 17px/1.35 var(--sans);
  }
  .wait {
    margin-left: 4px;
    font-size: 13px;
    color: var(--gold);
    white-space: nowrap;
  }
  .cat .price {
    font-size: 19px;
    font-variant-numeric: lining-nums;
  }
  .cat li p {
    margin-top: 2px;
    font-size: 15px;
    color: var(--muted);
  }
  .cat .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    margin-top: 8px;
  }
  .tags abbr {
    padding: 1px 6px;
    border: 1px solid var(--line);
    border-radius: 4px;
    font-size: 11px;
    font-weight: 600;
    text-decoration: none;
  }
  .legend {
    padding: 28px;
    border-radius: 6px;
    background: var(--paper-2);
  }
  .legend > p:not(.eyebrow) {
    margin-top: 6px;
    font-size: 14px;
    color: var(--muted);
  }
  .legend ul {
