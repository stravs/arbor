---
// Editor for malice and opening hours. Sits behind Cloudflare Access and saves
// through the Worker (worker/index.ts); `astro dev` runs the same API from astro.config.mjs.
import '@fontsource-variable/fraunces';
import '@fontsource-variable/instrument-sans';
import { Image } from 'astro:assets';
import { images } from '../data/site';
import { dayNames } from '../lib/content';

const names = dayNames.sl;
// The week on show and the one after it; the tabs get their dates in the browser.
const weeks = [0, 1];
---

<!doctype html>
<html lang="sl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Arbor – urejanje</title>
    <link rel="icon" type="image/png" href="/favicon.png" />
  </head>
  <body>
    <main>
      <Image class="logo" src={images.logo} alt="Arbor" width={108} loading="eager" />
      <p id="status" role="status">Nalagam …</p>

      <form id="form" hidden>
        <section>
          <h2>Malice</h2>
          <div class="tabs">
            {
              weeks.map((w) => <button type="button" data-week={w} aria-pressed={w === 0 ? 'true' : 'false'} />)
            }
          </div>
          {
            weeks.map((w) => (
              <div class="days" data-week-panel={w} hidden={w > 0}>
                {[1, 2, 3, 4, 5].map((day) => (
                  <fieldset>
                    <legend>
                      {names[day]} <small data-date-label />
                    </legend>
                    <div class="dishes" data-malice />
                  </fieldset>
                ))}
              </div>
            ))
          }
          <template id="dish">
            <input type="text" list="dishes" maxlength="200" autocomplete="off" aria-label="Jed" />
          </template>
          <datalist id="dishes"></datalist>
        </section>

        <section>
          <h2>Odpiralni čas</h2>
          <div class="hours">
            {
              [1, 2, 3, 4, 5, 6, 0].map((day) => (
                <div class="row" data-weekday={day}>
                  <label>
                    <input type="checkbox" data-open /> {names[day]}
                  </label>
                  <span class="times">
                    <input type="text" inputmode="numeric" maxlength="5" placeholder="10:00" pattern="([01]?\d|2[0-3])[:.][0-5]\d" title="Ura v 24-urni obliki, npr. 10:00 ali 22:00" data-from aria-label="Odpremo ob" required /> –
                    <input type="text" inputmode="numeric" maxlength="5" placeholder="10:00" pattern="([01]?\d|2[0-3])[:.][0-5]\d" title="Ura v 24-urni obliki, npr. 10:00 ali 22:00" data-to aria-label="Zapremo ob" required />
                  </span>
                </div>
              ))
            }
          </div>
        </section>

        <div class="bar">
          <span id="saved" role="status"></span>
          <button type="submit">Shrani</button>
        </div>
      </form>
    </main>
  </body>
</html>

<script>
  import { addDays, lunchWeek, shortDate, type Content, type Span } from '../lib/content';

  const API = '/pero/api/content';
  const $ = <T extends HTMLElement>(sel: string, root: ParentNode = document) => root.querySelector<T>(sel)!;
  const $$ = <T extends HTMLElement>(sel: string, root: ParentNode = document) => [...root.querySelectorAll<T>(sel)];

  const form = $<HTMLFormElement>('#form');
  const status = $('#status');
  const saved = $('#saved');
  const submit = $<HTMLButtonElement>('[type=submit]', form);
  const dishTemplate = $<HTMLTemplateElement>('#dish');

  type Loaded = Content & { today: string; dishes: string[]; saved: number };

  // For a minute or so after a save the server can still hand out the version before it.
  // The browser keeps what it saved, and a reload in that window shows that copy instead,
  // so saving again can't bring the old version back.
  const RECENT = 'pero:saved';
  const remember = (data: Loaded) => {
    try {
      localStorage.setItem(RECENT, JSON.stringify({ at: Date.now(), data }));
    } catch {}
  };
  const newest = (data: Loaded): Loaded => {
    try {
      const kept = JSON.parse(localStorage.getItem(RECENT) ?? 'null') as { at: number; data: Loaded } | null;
      if (kept && Date.now() - kept.at < 5 * 60_000 && kept.data.saved > data.saved) return { ...kept.data, today: data.today };
    } catch {}
    return data;
  };

  const addDish = (box: HTMLElement, dish = '') => {
    const input = (dishTemplate.content.cloneNode(true) as DocumentFragment).firstElementChild as HTMLInputElement;
    input.value = dish;
    box.append(input);
  };

  // 600 ↔ "10:00". Plain text fields, because <input type="time"> shows AM/PM in browsers set to English.
  const toClock = (mins: number) => `${String(Math.floor(mins / 60)).padStart(2, '0')}:${String(mins % 60).padStart(2, '0')}`;
  const toMins = (clock: string) => {
    const [hours, mins] = clock.split(/[:.]/).map(Number);
    return hours * 60 + mins;
  };

  // A weekday's row: an "open" checkbox and two time fields.
  const setSpan = (row: ParentNode, span: Span | null) => {
    const open = $<HTMLInputElement>('[data-open]', row);
    open.checked = !!span;
    $<HTMLInputElement>('[data-from]', row).value = toClock(span?.[0] ?? 10 * 60);
    $<HTMLInputElement>('[data-to]', row).value = toClock(span?.[1] ?? 22 * 60);
    syncRow(row);
  };
  const getSpan = (row: ParentNode): Span | null =>
    $<HTMLInputElement>('[data-open]', row).checked
      ? [toMins($<HTMLInputElement>('[data-from]', row).value), toMins($<HTMLInputElement>('[data-to]', row).value)]
      : null;
  const syncRow = (row: ParentNode) => {
    const open = $<HTMLInputElement>('[data-open]', row).checked;
    $$<HTMLInputElement>('[data-from], [data-to]', row).forEach((input) => (input.disabled = !open));
  };

  const show = (data: Loaded) => {
    // From Saturday on the first tab is already the coming week, matching the public page.
    const first = lunchWeek(data.today);
    const dates = [...first, ...lunchWeek(addDays(first[0], 7))];
    $$('[data-week]').forEach((tab, w) => (tab.textContent = `${shortDate(dates[w * 5])}–${shortDate(dates[w * 5 + 4])}`));
    $$('[data-malice]').forEach((box, i) => {
      box.dataset.date = dates[i];
      box.replaceChildren();
      // Always leave an empty field to type the next dish into.
      [...(data.malice[dates[i]] ?? []), ''].forEach((dish) => addDish(box, dish));
      while (box.children.length < 3) addDish(box);
    });
    $('#dishes').replaceChildren(...data.dishes.map((dish) => new Option(dish, dish)));
    $$('[data-date-label]').forEach((el, i) => (el.textContent = shortDate(dates[i])));
    $$('[data-weekday]').forEach((row) => setSpan(row, data.hours.week[Number(row.dataset.weekday)]));
  };

  const collect = (): Content => {
    const week: (Span | null)[] = [];
    $$('[data-weekday]').forEach((row) => (week[Number(row.dataset.weekday)] = getSpan(row)));
    return {
      malice: Object.fromEntries(
        $$('[data-malice]').map((box) => [box.dataset.date!, $$<HTMLInputElement>('input', box).map((i) => i.value)]),
      ),
      hours: { week },
    };
  };

  // The save button only shows while the form differs from what was last loaded or saved,
  // and the bar around it goes too unless it still has a message to show.
  // Empty dish fields don't count, as one is added as soon as the last gets typed into.
  const snapshot = () => {
    const { malice, hours } = collect();
    return JSON.stringify([Object.values(malice).map((dishes) => dishes.filter((d) => d.trim())), hours]);
  };
  let clean = '';
  const syncSubmit = () => {
    submit.hidden = snapshot() === clean;
    $('.bar').hidden = submit.hidden && !saved.textContent;
  };
  const showClean = (data: Loaded) => {
    show(data);
    clean = snapshot();
    syncSubmit();
  };

  // An expired Access session answers with a redirect to the login page instead of JSON.
  const request = async (init?: RequestInit) => {
    const res = await fetch(API, init).catch(() => null);
    if (res?.status === 400) throw new Error('Preverite vnos: ure zapiranja morajo biti po urah odpiranja.');
    if (!res?.ok || !res.headers.get('content-type')?.includes('json'))
      throw new Error('Povezava ni uspela. Osvežite stran in se po potrebi znova prijavite.');
    return (await res.json()) as Loaded;
  };

  form.addEventListener('change', (e) => {
    const row = (e.target as HTMLElement).closest('.row');
    if (row) syncRow(row);
    syncSubmit();
  });
  form.addEventListener('input', (e) => {
    saved.textContent = '';
    const input = e.target as HTMLInputElement;
    const box = input.closest<HTMLElement>('[data-malice]');
    if (box && input === box.lastElementChild && input.value) addDish(box);
    syncSubmit();
  });
  form.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    const tab = target.closest<HTMLElement>('[data-week]');
    if (tab) {
      $$('[data-week]').forEach((b) => b.setAttribute('aria-pressed', String(b === tab)));
      $$('[data-week-panel]').forEach((p) => (p.hidden = p.dataset.weekPanel !== tab.dataset.week));
    }
  });

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    submit.disabled = true;
    saved.textContent = 'Shranjujem …';
    try {
      const data = await request({ method: 'PUT', headers: { 'content-type': 'application/json' }, body: JSON.stringify(collect()) });
      remember(data);
      showClean(data);
      saved.textContent = 'Shranjeno. Na strani bo vidno v približno minuti.';
    } catch (err) {
      saved.textContent = (err as Error).message;
    }
    submit.disabled = false;
    syncSubmit();
  });

  try {
    showClean(newest(await request()));
    status.hidden = true;
    form.hidden = false;
  } catch (err) {
    status.textContent = (err as Error).message;
  }
</script>

<style>
  :global(body) {
    margin: 0;
    background: #f6f1e7;
    color: #1c241e;
    font: 19px/1.5 'Instrument Sans Variable', system-ui, sans-serif;
    -webkit-font-smoothing: antialiased;
  }
  :global(*) {
    box-sizing: border-box;
  }
  [hidden] {
    display: none !important;
  }
  main {
    --green: #0b4b24;
    --muted: #4d564e;
    --line: #d8cfbb;
    max-width: 1120px;
    margin: 0 auto;
    padding: 32px 20px 120px;
  }
  .logo {
    display: block;
    margin: 0 auto;
  }
  form {
    display: grid;
    gap: 0 56px;
  }
  @media (min-width: 900px) {
    form {
      grid-template-columns: 1fr 1fr;
      align-items: start;
    }
  }
  h2 {
    margin: 0;
    font-family: 'Fraunces Variable', Georgia, serif;
    font-weight: 380;
    font-size: 28px;
    letter-spacing: -0.02em;
  }
  section {
    min-width: 0;
    margin-top: 32px;
    padding-top: 28px;
    border-top: 1px solid var(--line);
  }
  #status {
    margin: 24px 0 0;
    color: var(--muted);
    font-size: 17px;
    text-align: center;
  }
  input,
  button {
    font: inherit;
    color: inherit;
  }
  input[type='text'] {
    padding: 10px 12px;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: #fffdf8;
  }
  input:disabled {
    opacity: 0.4;
  }
  input[type='checkbox'] {
    width: 22px;
    height: 22px;
    margin: 0 10px 0 0;
    accent-color: var(--green);
    vertical-align: -4px;
  }
  button {
    padding: 13px 24px;
    border: 0;
    border-radius: 999px;
    background: var(--green);
    color: #f6f1e7;
    font-weight: 600;
    font-size: 17px;
    cursor: pointer;
  }
  button:disabled {
    opacity: 0.4;
    cursor: default;
  }
  .tabs button[aria-pressed='false'] {
    background: none;
    box-shadow: inset 0 0 0 1.5px var(--green);
    color: var(--green);
  }
  .tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 20px;
  }
  .days {
    display: grid;
    gap: 18px;
    margin-top: 20px;
  }
  fieldset {
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }
  legend {
    margin-bottom: 6px;
    padding: 0;
    font-weight: 600;
  }
  .dishes {
    display: grid;
    gap: 8px;
  }
  .days small {
    margin-left: 4px;
    font-size: 16px;
    font-weight: 400;
    color: var(--muted);
  }
  input[type='text'] {
    width: 100%;
  }
  .times input[type='text'] {
    width: 4.5em;
    text-align: center;
  }
  .hours {
    margin-top: 16px;
  }
  .row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 10px 20px;
    padding: 12px 0;
    border-bottom: 1px solid var(--line);
  }
  .times {
    white-space: nowrap;
  }
  .bar {
    position: fixed;
    inset: auto 0 0;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 16px;
    /* Same side edges as main. */
    padding: 14px max(20px, calc((100% - 1120px) / 2 + 20px));
    border-top: 1px solid var(--line);
    background: #f6f1e7;
  }
  #saved {
    font-size: 16px;
    color: var(--muted);
  }
</style>
